{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YomagAudio",
  "version": "0.1.1",
  "identifier": "com.yomag.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src-tauri/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YomagAudio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 420,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/recordings/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "YomagAudio",
    "homepage": "https://github.com/Yomag84/yomag-audio",
    "shortDescription": "Windows audio routing, mixing, and multitrack recording app",
    "longDescription": "YomagAudio is a Windows desktop application for routing, mixing, and monitoring audio between hardware devices, running applications, and other machines on the network, with built-in multitrack recording and editing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../driver/YomagAudioDriver/x64/Release/YomagAudioDriver.sys": "driver/YomagAudioDriver/YomagAudioDriver.sys",
      "../driver/YomagAudioDriver/x64/Release/YomagAudioDriver.inf": "driver/YomagAudioDriver/YomagAudioDriver.inf",
      "../driver/YomagAudioDriver/README.md": "driver/YomagAudioDriver/README.md",
      "../driver/YomagAudioDriver/install-driver-step1.ps1": "driver/YomagAudioDriver/install-driver-step1.ps1",
      "../driver/YomagAudioDriver/install-driver-step2.ps1": "driver/YomagAudioDriver/install-driver-step2.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Yomag84/yomag-audio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0QUJGNkNFNTg4RERGNjcKUldSbjM0MVl6dmFyZFBkZXhaVVplSEp1RXhxM0ZwSi9nZ3pKa0Y0MzArVUpsR0RkM1NiT093ZTkK"
    }
  }
}
