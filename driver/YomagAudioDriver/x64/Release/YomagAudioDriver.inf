[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
CatalogFile = YomagAudioDriver.cat
DriverVer = 08/20/2026,1.0.1.0
PnpLockDown = 1

[Manufacturer]
%ManufacturerString% = YomagAudio, NTamd64

[YomagAudio.NTamd64]
%DeviceDesc% = YomagAudioDriver_Install, Root\YomagAudioCable

[SourceDisksNames]
1 = %DiskId1%

[SourceDisksFiles]
YomagAudioDriver.sys = 1

[DestinationDirs]
DefaultDestDir = 12

[YomagAudioDriver_Install]
CopyFiles = YomagAudioDriver.CopyFiles

[YomagAudioDriver.CopyFiles]
YomagAudioDriver.sys

[YomagAudioDriver_Install.Services]
AddService = YomagAudioDriver,0x00000002,YomagAudioDriver_Service_Inst

[YomagAudioDriver_Service_Inst]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\YomagAudioDriver.sys

; ACX drivers run on KMDF, not raw WDM/PortCls, so the KMDF library the
; INF asks the OS to load has to match what the driver was linked against
; (see YomagAudioDriver.vcxproj's KMDF_VERSION_MAJOR/MINOR globals).
[YomagAudioDriver_Install.Wdf]
KmdfService = YomagAudioDriver, YomagAudioDriver_wdfsect

[YomagAudioDriver_wdfsect]
KmdfLibraryVersion = 1.31

;
; Render endpoint (the circuit built in rendercircuit.cpp, bridge pin
; category KSNODETYPE_SPEAKER).
;
[YomagAudioDriver_Install.I.Speaker]
AddReg = YomagAudioDriver_Install.I.Speaker.AddReg

[YomagAudioDriver_Install.I.Speaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%SpeakerDeviceName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;
; Capture endpoint (the circuit built in capturecircuit.cpp, bridge pin
; category KSNODETYPE_MICROPHONE).
;
[YomagAudioDriver_Install.I.Microphone]
AddReg = YomagAudioDriver_Install.I.Microphone.AddReg

[YomagAudioDriver_Install.I.Microphone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicrophoneDeviceName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;
; Unlike PortCls, ACX circuits are self-contained (no separate Topology
; filter to cross-wire) - a single KSCATEGORY_AUDIO + KSCATEGORY_RENDER/
; CAPTURE + KSCATEGORY_REALTIME interface set per circuit is enough for
; AudioEndpointBuilder to enumerate each as its own endpoint.
;
[YomagAudioDriver_Install.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSName_Speaker%,    YomagAudioDriver_Install.I.Speaker
AddInterface = %KSCATEGORY_RENDER%,   %KSName_Speaker%,    YomagAudioDriver_Install.I.Speaker
AddInterface = %KSCATEGORY_REALTIME%, %KSName_Speaker%,    YomagAudioDriver_Install.I.Speaker
AddInterface = %KSCATEGORY_AUDIO%,    %KSName_Microphone%, YomagAudioDriver_Install.I.Microphone
AddInterface = %KSCATEGORY_CAPTURE%,  %KSName_Microphone%, YomagAudioDriver_Install.I.Microphone
AddInterface = %KSCATEGORY_REALTIME%, %KSName_Microphone%, YomagAudioDriver_Install.I.Microphone

[Strings]
ProviderString      = "YomagAudio"
ManufacturerString  = "YomagAudio"
DiskId1             = "YomagAudio Virtual Cable Installation Disk"
DeviceDesc          = "YomagAudio Virtual Cable"
ServiceDesc         = "YomagAudio Virtual Cable Driver"
SpeakerDeviceName    = "YomagAudio Virtual Cable Speaker"
MicrophoneDeviceName = "YomagAudio Virtual Cable Microphone"
KSName_Speaker       = "Speaker0"
KSName_Microphone    = "Microphone0"
KSCATEGORY_AUDIO     = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER    = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE   = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME  = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSNODETYPE_ANY       = "{00000000-0000-0000-0000-000000000000}"
Proxy.CLSID          = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
PKEY_AudioEndpoint_Association               = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

